{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "main": "worker.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "static",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alumni-db",
      "database_id": "f9abe0f7-ebd8-40d2-bf80-e9aefd9bdb20",
      "migrations_dir": "migrations"
    }
  ]
}
